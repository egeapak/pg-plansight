# Installation file for pg-plansight-exporter daemon package
# Specifies which files to install and where

# Binary executable
target/*/release/pg-plansight-exporter usr/bin/

# Systemd service file
crates/exporter/systemd/pg-plansight-exporter.service lib/systemd/system/

# Configuration files
crates/exporter/config/example.toml usr/share/doc/pg-plansight-exporter/

# Documentation
LICENSE usr/share/doc/pg-plansight-exporter/
CLAUDE.md usr/share/doc/pg-plansight-exporter/README.md