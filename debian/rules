#!/usr/bin/make -f

# Debian build rules for pg-loganalyze packages
# Uses cargo-deb for Rust package building

# Uncomment this to turn on verbose mode
#export DH_VERBOSE=1

# Rust/Cargo configuration
export CARGO_HOME = $(CURDIR)/debian/cargo_home
export RUSTUP_HOME = $(CURDIR)/debian/rustup_home

# Build optimization
export CARGO_PROFILE_RELEASE_LTO = true
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS = 1

# Cross-compilation support
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

# Map Debian architectures to Rust targets
ifeq ($(DEB_HOST_ARCH),amd64)
	RUST_TARGET = x86_64-unknown-linux-gnu
endif
ifeq ($(DEB_HOST_ARCH),arm64)
	RUST_TARGET = aarch64-unknown-linux-gnu
endif
ifeq ($(DEB_HOST_ARCH),armhf)
	RUST_TARGET = armv7-unknown-linux-gnueabihf
endif
ifeq ($(DEB_HOST_ARCH),i386)
	RUST_TARGET = i686-unknown-linux-gnu
endif

# Default to the current architecture if not cross-compiling
RUST_TARGET ?= $(shell rustc -vV | grep host | cut -d' ' -f2)

%:
	dh $@

override_dh_auto_clean:
	cargo clean || true
	rm -rf $(CARGO_HOME) $(RUSTUP_HOME)
	rm -rf target/
	dh_auto_clean

override_dh_auto_configure:
	# Create cargo home directory
	mkdir -p $(CARGO_HOME)
	# Add the target if cross-compiling
	if [ "$(RUST_TARGET)" != "$$(rustc -vV | grep host | cut -d' ' -f2)" ]; then \
		rustup target add $(RUST_TARGET); \
	fi

override_dh_auto_build:
	# Build both packages for the target architecture
	cargo build --release --target $(RUST_TARGET) -p pg-loganalyze
	cargo build --release --target $(RUST_TARGET) -p pg-loganalyze-exporter

override_dh_auto_test:
	# Run tests for the workspace
	cargo test --workspace --target $(RUST_TARGET)

override_dh_auto_install:
	# Use cargo-deb to generate the packages
	TARGET=$(RUST_TARGET) cargo deb --target $(RUST_TARGET) -p pg-loganalyze --no-build --output target/
	TARGET=$(RUST_TARGET) cargo deb --target $(RUST_TARGET) -p pg-loganalyze-exporter --no-build --output target/

override_dh_builddeb:
	# Move the generated .deb files to the parent directory
	mv target/*.deb ../
	# Call the default builddeb to handle the rest
	dh_builddeb

# Disable some steps that don't apply to Rust packages
override_dh_auto_install-arch:
override_dh_auto_install-indep:
override_dh_usrlocal:
override_dh_dwz:

.PHONY: override_dh_auto_clean override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_builddeb