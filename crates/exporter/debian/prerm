#!/bin/bash
set -e

# Package: pg-plansight-exporter
# Purpose: Pre-removal script for stopping service and cleanup

case "$1" in
    remove)
        # The package is going away: stop it and clear the boot preference.
        if [ -d /run/systemd/system ]; then
            systemctl stop pg-plansight-exporter.service || true
            systemctl disable pg-plansight-exporter.service || true
            systemctl daemon-reload || true
        fi

        echo "Plansight Exporter service stopped and disabled."
        ;;

    upgrade|deconfigure)
        # Deliberately nothing.
        #
        # `deconfigure` means the package STAYS installed and will be
        # reconfigured, so treating it as a removal (stop + disable) left the
        # unit disabled with nothing to re-enable it -- the follow-up
        # `postinst configure` has $2 set and so took the upgrade path.
        #
        # For `upgrade`: this arm used to stop AND disable the service,
        # which broke every upgrade in two ways: `disable` discards the
        # administrator's boot preference, and nothing started the service
        # again afterwards -- postinst only ran `enable` -- so upgrading the
        # package silently left the exporter stopped and monitoring went dark
        # until someone noticed.
        #
        # Replacing a running binary on disk is safe (the running process keeps
        # its inode), so the unit is left alone here and postinst restarts it
        # once the new binary is in place -- but only if it was already
        # running, which is what preserves the operator's intent in both
        # directions.
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0