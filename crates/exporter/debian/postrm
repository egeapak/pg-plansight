#!/bin/bash
set -e

# Package: pg-plansight-exporter
# Purpose: Post-removal script for cleanup

case "$1" in
    purge)
        # Remove configuration files and data on purge
        echo "Purging Plansight Exporter data and configuration..."
        
        rm -rf /etc/pg-plansight-exporter
        rm -rf /var/lib/pg-plansight-exporter
        rm -rf /var/log/pg-plansight-exporter

        # Remove user and group (only if no other packages are using them)
        if getent passwd pg-plansight >/dev/null 2>&1; then
            echo "Removing pg-plansight user..."
            deluser pg-plansight || true
        fi

        if getent group pg-plansight >/dev/null 2>&1; then
            echo "Removing pg-plansight group..."
            delgroup pg-plansight || true
        fi

        echo "Plansight Exporter completely purged."
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Keep data and configuration on normal removal
        echo "Plansight Exporter removed (configuration preserved)."
        echo "Use 'apt purge pg-plansight-exporter' to remove all data and configuration."
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0