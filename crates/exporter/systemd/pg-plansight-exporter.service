[Unit]
Description=Plansight Prometheus Exporter
Documentation=https://github.com/egeapak/pg-plansight
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pg-plansight
Group=pg-plansight

# Main command
ExecStart=/usr/bin/pg-plansight-exporter daemon --config /etc/pg-plansight-exporter/config.toml

# Reload configuration via SIGHUP
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Environment
Environment=RUST_LOG=info
Environment=PG_PLANSIGHT_STATE_DB=/var/lib/pg-plansight-exporter/state.db

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6

# File system access
ReadOnlyPaths=/
ReadWritePaths=/var/lib/pg-plansight-exporter
ReadOnlyPaths=/var/log/postgresql
ReadOnlyPaths=/etc/pg-plansight-exporter

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Process limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target