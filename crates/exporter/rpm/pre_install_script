#!/bin/bash
# Pre-installation script for pg-plansight-exporter RPM

# Create pg-plansight user and group if they don't exist
if ! getent group pg-plansight >/dev/null 2>&1; then
    echo "Creating pg-plansight group..."
    groupadd --system pg-plansight
fi

if ! getent passwd pg-plansight >/dev/null 2>&1; then
    echo "Creating pg-plansight user..."
    useradd --system --gid pg-plansight --home-dir /var/lib/pg-plansight-exporter \
            --no-create-home --comment "Plansight Exporter" \
            --shell /sbin/nologin pg-plansight
fi