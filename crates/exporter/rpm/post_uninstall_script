#!/bin/bash
# Post-uninstall script for pg-loganalyze-exporter RPM

# Only run cleanup on complete removal (not upgrade)
if [ "$1" -eq 0 ]; then
    echo "Purging PostgreSQL Log Analyzer Exporter data and configuration..."
    
    # Remove configuration and data directories
    rm -rf /etc/pg-loganalyze-exporter
    rm -rf /var/lib/pg-loganalyze-exporter  
    rm -rf /var/log/pg-loganalyze-exporter

    # Remove user and group (only if no other packages are using them)
    if getent passwd pg-loganalyze >/dev/null 2>&1; then
        echo "Removing pg-loganalyze user..."
        userdel pg-loganalyze || true
    fi

    if getent group pg-loganalyze >/dev/null 2>&1; then
        echo "Removing pg-loganalyze group..."
        groupdel pg-loganalyze || true
    fi

    echo "PostgreSQL Log Analyzer Exporter completely removed."
else
    echo "PostgreSQL Log Analyzer Exporter removed (configuration preserved for upgrade)."
fi