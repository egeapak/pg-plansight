# syntax=docker/dockerfile:1
# Release build of the pg_plansight extension. Ubuntu 18.04 supplies the compilers
# and libclang pgrx needs; zig is the linker and links against glibc 2.17 stubs
# (see zig-link), so the shipped .so loads on glibc 2.17 and newer (CentOS 7,
# Ubuntu 16.04, Debian 9 upward). PostgreSQL is built from source with Debian's
# directory layout, so `cargo pgrx package` stages files at the paths the deb/rpm
# variants in Cargo.toml expect.
#
#   just ext-package-bionic 16
#   # or directly (add --platform linux/arm64 for arm64):
#   docker buildx build -f crates/pg_extension/docker/Dockerfile.bionic \
#     --build-arg PG_MAJOR=16 --target export --output type=local,dest=dist .
#
FROM ubuntu:18.04 AS toolchain
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        curl ca-certificates build-essential pkg-config libssl-dev zlib1g-dev \
        bison flex binutils clang-10 libclang-10-dev rpm dpkg-dev fakeroot >/dev/null
ENV LIBCLANG_PATH=/usr/lib/llvm-10/lib CLANG_PATH=/usr/bin/clang-10
ARG RUST_VERSION=1.96.0
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal >/dev/null
ENV PATH=/root/.cargo/bin:$PATH
RUN cargo install cargo-deb@3.8.0 cargo-generate-rpm@0.19.0 --locked
ARG ZIG_VERSION=0.15.1
RUN set -eu; \
    apt-get update -qq && apt-get install -y -qq --no-install-recommends xz-utils >/dev/null; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) sum=c61c5da6edeea14ca51ecd5e4520c6f4189ef5250383db33d01848293bfafe05 ;; \
        aarch64) sum=bb4a8d2ad735e7fba764c497ddf4243cb129fece4148da3222a7046d3f1f19fe ;; \
        *) echo "no zig checksum for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-$arch-linux-${ZIG_VERSION}.tar.xz"; \
    echo "$sum  /tmp/zig.tar.xz" | sha256sum -c - >/dev/null; \
    tar xJf /tmp/zig.tar.xz -C /opt && rm /tmp/zig.tar.xz; \
    ln -s "/opt/zig-$arch-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig
COPY crates/pg_extension/docker/zig-link /usr/local/bin/zig-link

FROM toolchain AS postgres
ARG PG_MAJOR=16
# Pinned minor per major so a tag rebuilds the same headers; only headers and
# pg_config are needed to build against. Override with --build-arg PG_VERSION=.
ARG PG_VERSION=
RUN set -eu; \
    v="${PG_VERSION}"; \
    if [ -z "$v" ]; then \
        case "${PG_MAJOR}" in \
            12) v=12.22 ;; 13) v=13.23 ;; 14) v=14.24 ;; 15) v=15.19 ;; \
            16) v=16.15 ;; 17) v=17.11 ;; 18) v=18.6 ;; \
            *) echo "no pinned PostgreSQL minor for ${PG_MAJOR}" >&2; exit 1 ;; \
        esac; \
    fi; \
    echo "building PostgreSQL $v"; \
    curl -fsSL "https://ftp.postgresql.org/pub/source/v$v/postgresql-$v.tar.bz2" | tar xj -C /tmp; \
    cd "/tmp/postgresql-$v"; \
    ./configure --prefix="/usr/lib/postgresql/${PG_MAJOR}" \
        --datadir="/usr/share/postgresql/${PG_MAJOR}" \
        --without-icu --without-readline >/dev/null; \
    make -j"$(nproc)" >/tmp/pg-make.log 2>&1 || { tail -50 /tmp/pg-make.log >&2; exit 1; }; \
    make install >/tmp/pg-install.log 2>&1 || { tail -50 /tmp/pg-install.log >&2; exit 1; }; \
    rm -rf /tmp/postgresql-*

FROM postgres AS build
ARG PG_MAJOR=16
# Must equal the pgrx requirement of the manifest being built (the pg12 manifest
# pins 0.13.1, the rest 0.19.1); version-check.yml enforces both.
ARG PGRX_VERSION=0.19.1
ARG PGRX_VERSION_PG12=0.13.1
RUN set -eu; \
    v="${PGRX_VERSION}"; [ "${PG_MAJOR}" != 12 ] || v="${PGRX_VERSION_PG12}"; \
    cargo install --locked --version "=$v" cargo-pgrx
COPY . /src
WORKDIR /src
RUN set -eu; \
    pgc="/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config"; \
    cargo pgrx init "--pg${PG_MAJOR}" "$pgc"; \
    dir=crates/pg_extension; [ "${PG_MAJOR}" = 12 ] && dir=crates/pg_extension/pg12; \
    cd "$dir"; \
    # zig links only the extension: tools such as cargo-pgrx link system
    # libraries (libssl) that zig's glibc target does not search for.
    triple="$(uname -m | tr a-z A-Z)_UNKNOWN_LINUX_GNU"; \
    env "CARGO_TARGET_${triple}_LINKER=/usr/local/bin/zig-link" \
        cargo pgrx package --no-default-features --features "pg${PG_MAJOR}" --pg-config "$pgc"; \
    cargo deb --no-build --variant "pg${PG_MAJOR}"; \
    /src/scripts/add-deb-md5sums.sh target/debian/*.deb; \
    # xz: rpm 4.11 (CentOS 7) cannot read the default zstd payload.
    cargo generate-rpm --variant "pg${PG_MAJOR}" --auto-req disabled --payload-compress xz; \
    mkdir -p /out; \
    cp target/debian/*.deb target/generate-rpm/*.rpm /out/

FROM scratch AS export
COPY --from=build /out/ /
